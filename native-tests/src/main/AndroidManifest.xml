<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="SuperTextView Native Smoke"
        android:supportsRtl="true" />
    <!-- The runner and the target app intentionally live in the same APK. -->
    <instrumentation
        android:name="com.coorchice.nativetests.NativeSmokeInstrumentation"
        android:targetPackage="com.coorchice.nativetests"
        android:functionalTest="true"
        android:label="GIF JNI native smoke" />
</manifest>
